// Nextflow configuration file

// Global default params
params {
    out_dir = 'output_dir_1'
}

// Process configuration
process {
    // Default settings
    executor = 'slurm'

    // Default resources
    cpus = 1
    memory = '4 GB'
    time = '1h'

    // Process-specific settings

    // Currently commented out in the pipeline (CLUSTERS_TO_FASTA process),
    // kept here in case it's re-enabled
    withName: CLUSTERS_TO_FASTA {
        cpus = 5
        memory = '100 GB'
        time = '3h'
        queue = 'standard,short,long,fat'
    }

    withName: MAFFT {
        cpus = 10
        memory = '50 GB'
        time = '6h'
        maxForks = 4
        errorStrategy = 'retry'
        maxRetries = 2
        queue = 'standard,short,long,fat'
    }

    withName: FASTTREE {
        cpus = 10
        memory = '50 GB'
        time = '12h'
        maxForks = 4
        errorStrategy = 'retry'
        maxRetries = 2
        queue = 'standard,short,long,fat'
    }

    withName: RF_MODEL {
        cpus = 30
        memory = '100 GB'
        time = '12h'
        errorStrategy = 'retry'
        maxRetries = 2
        queue = 'standard,short,long,fat'
    }

    withName: PHYLOGLM {
        cpus = 15
        memory = '100 GB'
        time = '12h'
        maxForks = 4
        errorStrategy = 'retry'
        maxRetries = 2
        queue = 'standard,short,long,fat'
    }

    // MERGE_RF_RESULTS has no resource directives in the pipeline,
    // so it falls back to the default cpus/memory/time above
    withName: MERGE_RF_RESULTS {
        cpus = 1
        memory = '4 GB'
        time = '1h'
    }
}

// Executor configuration
executor {
    name = 'slurm'
    queueSize = 20
    submitRateLimit = '10 sec'
}

// Report configuration
report {
    enabled = true
    file = "${params.out_dir}/nextflow_report.html"
}

timeline {
    enabled = true
    file = "${params.out_dir}/nextflow_timeline.html"
}

trace {
    enabled = true
    file = "${params.out_dir}/nextflow_trace.txt"
}

dag {
    enabled = true
    file = "${params.out_dir}/nextflow_dag.svg"
}
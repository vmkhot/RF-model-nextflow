read
    mol pqr "{pqrfile}"
end

elec
    mg-auto
    mol 1

    fgcent {fgcent}    # fine grid center
    cgcent mol 1       # coarse grid center
    fglen {fglen}
    cglen {cglen}
    dime {dime}
    lpbe                # linear Poisson–Boltzmann equation
    bcfl sdh            # Single Debye–Hückel boundary condition
    pdie 2.0            # protein dielectric
    sdie 78.0           # solvent dielectric
    chgm spl2           # cubic B-spline charge discretization
    srfm smol           # smoothed molecular surface
    swin 0.3
    temp 310.0          # temperature (K)
    sdens 10.0
    calcenergy no
    calcforce no
    srad {srad}         # solvent radius

    # Ionic conditions for pH 1
    ion charge +1 conc 0.1 radius 2.0     # H+ ions (0.1 M)
    ion charge -1 conc 0.1 radius 1.8     # Cl- counterions (0.1 M)

    write pot dx "{mapfile}"
end

quit
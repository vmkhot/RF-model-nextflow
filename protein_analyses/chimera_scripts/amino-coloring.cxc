color :gly #ebebeb
color :his #8282d2
color :ile,leu,val #0f820f
color :lys #145aff
color :met #e6e600
color :phe #3232aa
color :pro #dc9682
color :ser,thr #fa9600
color :trp #b45ab4
color :tyr #3232aa
color :asx,glx #ff69b4
